---
import { services, townPages } from '../config/catalog';
import { SITE, formatAddress, mapsUrl } from '../config/site';
import ContactLink from './ContactLink.astro';

const year = new Date().getFullYear();
const liveServices = services.filter((service) => service.live);
const liveTowns = townPages.filter((town) => town.live);
const plainTowns = [
  ...townPages.filter((town) => !town.live).map((town) => town.name),
  ...SITE.listOnlyTowns,
];
---

<footer class="surface-dark bg-ink text-white">
  <div class="wrap section grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="brand">
        <img src={SITE.logo} width="28" height="28" alt="" />
        {SITE.name}
      </a>
      <p class="mt-3 text-sm leading-relaxed text-white/80">
        Residential and commercial electrical work in Sioux Falls and nearby towns.
      </p>
      <ContactLink track="call-footer" class="mt-4 inline-flex items-center gap-2 font-semibold text-white" />
      <a class="mt-2 block break-words text-sm text-white/80 underline" href={`mailto:${SITE.email}`}>
        {SITE.email}
      </a>
      <address class="mt-3 text-sm not-italic leading-relaxed text-white/80">
        {formatAddress()}
      </address>
      <a class="mt-3 inline-block text-sm font-semibold text-white underline" href={mapsUrl()} rel="noopener noreferrer">
        Get directions
      </a>
      {
        SITE.hours && (
          <p class="mt-4 text-sm text-white/80">
            <span class="font-semibold text-white">Hours: </span>
            {SITE.hours.label}
          </p>
        )
      }
      {SITE.available247 && <p class="mt-2 text-sm font-semibold text-white">{SITE.availabilityNote}</p>}
    </div>

    <div>
      <h2 class="text-sm font-bold">Services</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          liveServices.map((service) => (
            <li>
              <a href={service.href} class="text-white/80 hover:text-white hover:underline">
                {service.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold">Towns</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          liveTowns.map((town) => (
            <li>
              <a href={town.href === '/' ? '/#service-area' : town.href} class="text-white/80 hover:text-white hover:underline">
                {town.name}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-sm leading-relaxed text-white/80">Also serving {plainTowns.join(', ')}.</p>
    </div>

    <div>
      <h2 class="text-sm font-bold">Contact</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/contact" class="text-white/80 hover:text-white hover:underline">Contact</a></li>
        <li><a href="/about" class="text-white/80 hover:text-white hover:underline">About</a></li>
        <li><a href="/#quote" class="text-white/80 hover:text-white hover:underline">Request service</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 px-4 py-4 text-center text-xs text-white/70">
    <p>
      &copy; {year} {SITE.name}
      <span aria-hidden="true"> · </span>
      Not affiliated with any other company of a similar name.
    </p>
  </div>
</footer>
