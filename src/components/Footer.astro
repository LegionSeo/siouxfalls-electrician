---
import { services, townPages } from '../config/catalog';
import { SITE, formatAddress, mapsUrl } from '../config/site';
import ContactLink from './ContactLink.astro';

const year = new Date().getFullYear();
const liveServices = services.filter((service) => service.live);
const liveTowns = townPages.filter((town) => town.live);
const plainTowns = townPages.filter((town) => !town.live).map((town) => town.name);
---

<footer class="surface-dark bg-ink text-white">
  <div class="wrap section grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="brand">
        <img src={SITE.logo} width="142" height="64" alt={SITE.logoText} />
      </a>
      <p class="mt-3 text-sm leading-relaxed on-dark">
        Residential and commercial electrical work in Sioux Falls and nearby towns.
      </p>
      <p class="mt-3 text-sm leading-relaxed on-dark">
        Sioux Falls Electricians is a referral service operated by Midwest Leads LLC, Sioux Falls, SD.
      </p>
      <ul class="mt-4 flex items-center gap-3">
        <li>
          <a
            class="inline-flex on-dark hover:text-white"
            href="https://www.linkedin.com/company/sioux-falls-electricians"
            target="_blank"
            rel="noopener"
            aria-label="Sioux Falls Electricians on LinkedIn"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.37-1.85 3.6 0 4.26 2.37 4.26 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0z"
              />
            </svg>
          </a>
        </li>
        <li>
          <a
            class="inline-flex on-dark hover:text-white"
            href="https://www.instagram.com/siouxfallselectricians/"
            target="_blank"
            rel="noopener"
            aria-label="Sioux Falls Electricians on Instagram"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.15-3.23 1.66-4.77 4.92-4.92C8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95C23.73 2.7 21.31.27 16.95.07 15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.41-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"
              />
            </svg>
          </a>
        </li>
      </ul>
      <ContactLink track="call-footer" class="mt-4 inline-flex items-center gap-2 font-semibold text-white" />
      <a class="mt-2 block break-words text-sm on-dark underline" href={`mailto:${SITE.email}`}>
        {SITE.email}
      </a>
      <address class="mt-3 text-sm not-italic leading-relaxed on-dark">
        {formatAddress()}
      </address>
      <a class="mt-3 inline-block text-sm font-semibold text-white underline" href={mapsUrl()} rel="noopener noreferrer">
        Get directions
      </a>
      {
        SITE.hours && (
          <p class="mt-4 text-sm on-dark">
            <span class="font-semibold text-white">Hours: </span>
            {SITE.hours.label}
          </p>
        )
      }
      {SITE.available247 && <p class="mt-2 text-sm font-semibold text-white">{SITE.availabilityNote}</p>}
    </div>

    <div class="foot-col">
      <h2>Services</h2>
      <ul class="foot-links">
        {
          liveServices.map((service) => (
            <li>
              <a href={service.href} class="on-dark hover:text-white hover:underline">
                {service.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="foot-col">
      <h2>Towns</h2>
      <ul class="foot-links">
        {
          liveTowns.map((town) => (
            <li>
              <a href={town.href === '/' ? '/#service-area' : town.href} class="on-dark hover:text-white hover:underline">
                {town.name}
              </a>
            </li>
          ))
        }
      </ul>
      {plainTowns.length > 0 && <p class="mt-4 text-sm leading-relaxed on-dark">Also serving {plainTowns.join(', ')}.</p>}
      <p class="mt-4">
        <a href="/service-area" class="on-dark hover:text-white hover:underline">Service area</a>
      </p>
    </div>

    <div class="foot-col">
      <h2>Contact</h2>
      <ul class="foot-links">
        <li><a href="/contact" class="on-dark hover:text-white hover:underline">Contact</a></li>
        <li><a href="/about" class="on-dark hover:text-white hover:underline">About</a></li>
        <li><a href="/#quote" class="on-dark hover:text-white hover:underline">Request service</a></li>
        <li><a href="/privacy-policy" class="on-dark hover:text-white hover:underline">Privacy Policy</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t rule-faint px-4 py-4 text-center text-xs on-dark-faint">
    <p>
      &copy; {year} {SITE.name}
      <span aria-hidden="true"> · </span>
      Not affiliated with any other company of a similar name.
    </p>
  </div>
</footer>
