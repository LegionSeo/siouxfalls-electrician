---
import MapEmbed from './MapEmbed.astro';
import Photo from './Photo.astro';
import {
  brandonAnswer,
  brandonFaqs,
  brandonHousing,
  brandonHousingSource,
  brandonHousingSourceHref,
  brandonJobs,
  brandonOutageLink,
  brandonPermits,
  brandonServing,
  brandonWarningNote,
  brandonWarnings,
  brandonWorkIntro,
  withPhone,
  type TextPart,
} from '../content/brandon-town';
import type { TownPlace } from '../content/town-places';

interface Props {
  phone: string;
  place: TownPlace;
  mapQuery: string;
  preview: string;
}

const { phone, place, mapQuery, preview } = Astro.props;

function partsWithPhone(parts: TextPart[]): TextPart[] {
  return parts.map((part) => ({ ...part, text: withPhone(part.text, phone) }));
}

function faqParts(paragraph: string): TextPart[] {
  const text = withPhone(paragraph, phone);
  const { phrase, href } = brandonOutageLink;
  const at = text.indexOf(phrase);
  if (at === -1) return [{ text }];
  return [
    { text: text.slice(0, at) },
    { text: phrase, href },
    { text: text.slice(at + phrase.length) },
  ].filter((part) => part.text.length > 0);
}
---

<section class="bg-paper">
  <div class="section">
    <p class="measure text-lg">{withPhone(brandonAnswer, phone)}</p>
    <p class="mt-6 text-sm text-muted">Updated <time datetime="2026-10">October 2026</time></p>
  </div>
</section>

<section class="bg-white" aria-labelledby="work-heading">
  <div class="section">
    <div class="block-head">
      <h2 id="work-heading">Common electrical work in Brandon</h2>
      <p class="lede">{brandonWorkIntro}</p>
    </div>
    <ul class="job-list">
      {
        brandonJobs.map((job) => (
          <li>
            {partsWithPhone(job).map((part) =>
              part.href ? (
                <a class="text-link" href={part.href}>
                  {part.text}
                </a>
              ) : (
                part.text
              ),
            )}
          </li>
        ))
      }
    </ul>
    <div class="warn-block">
      <h3>Warning signs</h3>
      <p class="measure">Call us if you notice any of these.</p>
      <ul class="warn-list">
        {brandonWarnings.map((item) => <li>{item}</li>)}
      </ul>
      <p class="measure warn-note">{brandonWarningNote}</p>
    </div>
  </div>
</section>

<section class="bg-paper" id="place-story" aria-labelledby="homes-heading">
  <div class="section">
    <div class="block-head">
      <h2 id="homes-heading">Brandon homes and what they mean for your wiring</h2>
    </div>
    <figure class="place-card">
      <div class="place-frame">
        <Photo
          photo={place.photo}
          sizes="(min-width: 1024px) 720px, 100vw"
          loading="lazy"
          class="place-img"
          pictureClass="place-picture"
        />
      </div>
      <figcaption class="place-caption">
        <span class="place-caption-title">{place.caption}</span>
        <span class="place-credit">
          Photo by {place.author}.
          <a class="text-link" href={place.licenseUrl} rel="license">{place.license}</a>.
          <a class="text-link" href={place.sourceUrl}>Wikimedia Commons</a>.
          Resized.
        </span>
      </figcaption>
    </figure>
    <div class="place-copy housing-copy">
      {
        brandonHousing.map((paragraph, index) => (
          <p class:list={['measure', index > 0 && 'mt-4']}>{paragraph}</p>
        ))
      }
      <p class="source-note">
        <a class="text-link" href={brandonHousingSourceHref} rel="noopener noreferrer">{brandonHousingSource}</a>
      </p>
    </div>
  </div>
</section>

<section class="bg-white" aria-labelledby="permit-heading">
  <div class="section">
    <div class="block-head">
      <h2 id="permit-heading">Electrical permits in Brandon</h2>
    </div>
    <div class="place-copy">
      {
        brandonPermits.map((paragraph, index) => (
          <p class:list={['measure', index > 0 && 'mt-4']}>
            {paragraph.map((part) =>
              part.href ? (
                <a class="text-link" href={part.href} rel="noopener noreferrer">
                  {part.text}
                </a>
              ) : (
                part.text
              ),
            )}
          </p>
        ))
      }
    </div>
  </div>
</section>

<section class="bg-paper" aria-labelledby="brandon-faq-heading">
  <div class="section">
    <div class="block-head">
      <h2 id="brandon-faq-heading">FAQs: electricians in Brandon</h2>
    </div>
    <div class="brandon-faq">
      {
        brandonFaqs.map((item) => (
          <article>
            <h3>{item.question}</h3>
            {item.paragraphs.map((paragraph) => (
              <p class="measure">
                {faqParts(paragraph).map((part) =>
                  part.href ? (
                    <a class="text-link" href={part.href} rel="noopener noreferrer">
                      {part.text}
                    </a>
                  ) : (
                    part.text
                  ),
                )}
              </p>
            ))}
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="bg-white" aria-labelledby="serving-heading">
  <div class="section">
    <div class="block-head">
      <h2 id="serving-heading">Serving Brandon</h2>
    </div>
    <p class="measure">
      {
        brandonServing.map((part) =>
          part.href ? (
            <a class="text-link" href={part.href}>
              {part.text}
            </a>
          ) : (
            part.text
          ),
        )
      }
    </p>
    <div class="town-work mt-8">
      <div>
        <h3 id="map-heading">Map of Brandon</h3>
        <p class="lede">This pin marks the town, not your house. When you call, give us the address where you need us.</p>
        <MapEmbed
          src={`https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&z=12&output=embed`}
          title="Map of Brandon, South Dakota"
          label={mapQuery}
          preview={preview}
        />
      </div>
    </div>
  </div>
</section>
