---
import DataTable from './DataTable.astro';
import InlineText from './InlineText.astro';
import { PRICE_LABEL, type PageBrief } from '../content/brief-sections';

interface Props {
  brief: PageBrief;
  jumps?: boolean;
}

const { brief, jumps = false } = Astro.props;
---

{
  jumps && brief.jumps && (
    <section class="bg-white" aria-label="On this page">
      <div class="section">
        <nav aria-label="On this page">
          <ul class="jump-row">
            {brief.jumps.map((jump) => (
              <li>
                <a class="text-link" href={jump.href}>
                  {jump.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </section>
  )
}

{
  !jumps &&
    brief.sections.map((section) => (
      <section class="bg-white" aria-labelledby={section.id}>
        <div class="section">
          <h2 id={section.id}>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p class="measure mt-4">
              <InlineText text={paragraph} />
            </p>
          ))}
          {section.table && (
            <DataTable
              caption={section.table.caption}
              columns={section.table.columns}
              rows={section.table.rows}
              source={section.table.source}
              showLabel={section.table.showLabel}
            />
          )}
          {section.blocks.map((block) => (
            <>
              {block.heading && <h3 class="mt-8">{block.heading}</h3>}
              {block.paragraphs.map((paragraph) => (
                <p class="measure mt-4">
                  <InlineText text={paragraph} />
                </p>
              ))}
              {block.list && (
                <ul class="brief-list">
                  {block.list.map((item) => (
                    <li>
                      <InlineText text={item} />
                    </li>
                  ))}
                </ul>
              )}
              {block.showLabel && <p class="price-note">{PRICE_LABEL}</p>}
              {block.source && <p class="price-source">{block.source}</p>}
            </>
          ))}
          {section.links.length > 0 && (
            <ul class="brief-links">
              {section.links.map((link) => (
                <li>
                  <a class="text-link" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    ))
}
