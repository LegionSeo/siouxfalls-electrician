---
import ContactLink from './ContactLink.astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { SITE } from '../config/site';
import type { PhotoSlot } from '../config/site';

interface Props {
  photo: PhotoSlot;
  eyebrow: string;
  title: string;
  sub: string;
  /** request: Call + Request service. reach: Call + Text, for the contact page. */
  actions?: 'request' | 'reach';
}

const { photo, eyebrow, title, sub, actions = 'request' } = Astro.props;
---

<section class="hero page-hero surface-dark">
  <div class="hero-media">
    <Photo photo={photo} pictureClass="hero-picture" sizes="100vw" loading="eager" fetchpriority="high" class="hero-img" />
    <div class="hero-shade" aria-hidden="true"></div>
  </div>
  <div class="wrap hero-copy">
    <p class="eyebrow eyebrow-on-dark">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="hero-sub">{sub}</p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      {
        actions === 'reach' ? (
          <>
            <a class="btn btn-copper w-full sm:w-auto" href={SITE.phoneHref} data-track="call-contact-hero" data-contact-channel="tel">
              <Icon name="phone" class="h-5 w-5" />
              <span>Call {SITE.phoneDisplay}</span>
            </a>
            <a class="btn btn-line w-full sm:w-auto" href={SITE.smsHref} data-track="sms-contact-hero" data-contact-channel="sms">
              <Icon name="chat" class="h-5 w-5" />
              <span>Text {SITE.phoneDisplay}</span>
            </a>
          </>
        ) : (
          <>
            <ContactLink track="call-page-hero" class="btn btn-copper w-full sm:w-auto" />
            <a href="/contact" class="btn btn-line w-full sm:w-auto">Request service</a>
          </>
        )
      }
    </div>
  </div>
</section>
