---
import ContactLink from './ContactLink.astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { SITE } from '../config/site';
import type { PhotoSlot } from '../config/site';

interface Props {
  photo: PhotoSlot;
  eyebrow: string;
  title: string;
  /** Second headline line. The visible H1 is still one heading. */
  titleAfter?: string;
  sub: string;
  /** request: Call + Request service. reach: Call + Text, for the contact page. */
  actions?: 'request' | 'reach';
  /** Town heroes use a wider headline so the first line stays on one line. */
  town?: boolean;
}

const { photo, eyebrow, title, sub, titleAfter, actions = 'request', town = false } = Astro.props;
---

<section class:list={['hero page-hero surface-dark', town && 'hero-town']}>
  <div class="hero-media">
    <Photo photo={photo} pictureClass="hero-picture" sizes="100vw" loading="eager" fetchpriority="high" class="hero-img" />
    <div class="hero-shade" aria-hidden="true"></div>
  </div>
  <div class="wrap hero-copy">
    <p class="eyebrow eyebrow-on-dark">{eyebrow}</p>
    <h1>
      {title}
      {titleAfter && (
        <>
          <br />
          {titleAfter}
        </>
      )}
    </h1>
    <p class="hero-sub">{sub}</p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      {
        actions === 'reach' ? (
          <>
            <a class="btn btn-gold w-full sm:w-auto" href={SITE.phoneHref} data-track="call-contact-hero" data-contact-channel="tel">
              <Icon name="phone" class="h-5 w-5" />
              <span>Call {SITE.phoneDisplay}</span>
            </a>
            {
              SITE.smsEnabled ? (
                <a class="btn btn-line w-full sm:w-auto" href={SITE.smsHref} data-track="sms-contact-hero" data-contact-channel="sms">
                  <Icon name="chat" class="h-5 w-5" />
                  <span>Text {SITE.phoneDisplay}</span>
                </a>
              ) : (
                <a class="btn btn-line w-full sm:w-auto" href="#request-form">Send a note</a>
              )
            }
          </>
        ) : (
          <>
            <ContactLink track="call-page-hero" class="btn btn-gold w-full sm:w-auto" />
            <a href="/contact" class="btn btn-line w-full sm:w-auto">Request service</a>
          </>
        )
      }
    </div>
  </div>
</section>
