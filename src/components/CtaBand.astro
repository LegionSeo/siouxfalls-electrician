---
import ContactLink from './ContactLink.astro';
import Photo from './Photo.astro';
import { SITE } from '../config/site';
import type { PhotoSlot } from '../config/site';

interface Props {
  photo: PhotoSlot;
  heading: string;
}

const { photo, heading } = Astro.props;
---

<section class="surface-dark relative overflow-hidden bg-ink text-white">
  <Photo photo={photo} pictureClass="hero-picture opacity-30" sizes="100vw" loading="lazy" class="hero-img" />
  <div class="absolute inset-0 ink-shade" aria-hidden="true"></div>
  <div class="wrap section relative">
    <h2 class="max-w-[18ch] text-white">{heading}</h2>
    <p class="mt-4 max-w-[46ch] on-dark-soft">
      {SITE.available247 ? SITE.availabilityNote : 'Call and say what happened.'} You get a written quote before work starts.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
      <ContactLink track="call-page-cta" class="btn btn-copper w-full sm:w-auto" />
      <a class="font-semibold text-white underline" href={`mailto:${SITE.email}`}>Email {SITE.email}</a>
    </div>
  </div>
</section>
