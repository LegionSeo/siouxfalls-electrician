---
import { footerTowns, guides, serviceGroups, services } from '../config/catalog';
import { SITE } from '../config/site';
import ContactLink from './ContactLink.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header data-site-header class="surface-dark sticky top-0 z-40 border-b border-white/10 bg-ink text-white">
  <div class="header-bar mx-auto flex h-full max-w-[1200px] items-center justify-between gap-3 px-4">
    <a href="/" class="flex min-w-0 items-center gap-2">
      <img src={SITE.logo} width="32" height="32" alt="" />
      <span class="truncate text-[0.95rem] font-extrabold leading-none tracking-tight sm:text-base">
        {SITE.name}
      </span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-6 lg:flex">
      <div class="group relative">
        <button type="button" class="nav-link" aria-haspopup="true">
          Services
          <Icon name="caret" class="h-4 w-4" />
        </button>
        <div class="mega">
          <div class="grid grid-cols-2 gap-x-8 gap-y-5 xl:grid-cols-3">
            {
              serviceGroups.map((group) => (
                <div>
                  <p class="text-xs font-bold uppercase tracking-wide text-teal">{group}</p>
                  <ul class="mt-2 space-y-1">
                    {services
                      .filter((service) => service.group === group)
                      .map((service) => (
                        <li>
                          <a href={service.href} class="block rounded-lg py-1 text-sm font-semibold text-ink hover:text-link">
                            {service.name}
                          </a>
                        </li>
                      ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="group relative">
        <button type="button" class="nav-link" aria-haspopup="true">
          Service Area
          <Icon name="caret" class="h-4 w-4" />
        </button>
        <div class="dropdown dropdown-end">
          <a href="/locations" class="block rounded-lg px-3 py-2 text-sm font-semibold text-ink hover:bg-paper">
            All areas
          </a>
          {
            footerTowns.map((town) => (
              <a
                href={town.href}
                aria-current={path === town.href ? 'page' : undefined}
                class="block rounded-lg px-3 py-2 text-sm font-semibold text-ink hover:bg-paper"
              >
                {town.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="group relative">
        <button type="button" class="nav-link" aria-haspopup="true">
          Guides
          <Icon name="caret" class="h-4 w-4" />
        </button>
        <div class="dropdown dropdown-end">
          <a href="/guides" class="block rounded-lg px-3 py-2 text-sm font-semibold text-ink hover:bg-paper">
            All guides
          </a>
          {
            guides.map((guide) => (
              <a href={guide.href} class="block rounded-lg px-3 py-2 text-sm font-semibold text-ink hover:bg-paper">
                {guide.title}
              </a>
            ))
          }
        </div>
      </div>

      <a href="/about" class="nav-link" aria-current={path === '/about' ? 'page' : undefined}>About</a>
      <a href="/contact" class="nav-link" aria-current={path === '/contact' ? 'page' : undefined}>Contact</a>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/#quote" class="hidden text-sm font-bold text-white underline-offset-2 hover:underline lg:inline">
        Request service
      </a>
      <ContactLink
        track="call-header"
        class="btn btn-copper hidden px-4 lg:inline-flex"
        label={SITE.phoneDisplay}
      />
      <ContactLink
        track="call-header-m"
        class="btn btn-copper h-12 w-12 min-h-12 rounded-full px-0 lg:hidden"
        label={`Call ${SITE.phoneDisplay}`}
        iconOnly
      />

      <details class="relative lg:hidden">
        <summary
          class="flex h-12 w-12 cursor-pointer list-none items-center justify-center rounded-xl border border-white/30 [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <Icon name="menu" class="menu-open-icon h-5 w-5" />
          <Icon name="x" class="menu-close-icon h-5 w-5" />
        </summary>
        <div class="surface-light absolute right-0 top-full z-50 mt-2 max-h-[calc(100dvh-8rem-env(safe-area-inset-bottom))] w-[min(20rem,calc(100vw-2rem))] overflow-auto rounded-2xl bg-white p-4 text-ink shadow-xl">
          <p class="px-1 text-xs font-bold uppercase tracking-wide text-teal">Services</p>
          {
            serviceGroups.map((group) => (
              <div class="mt-3">
                <p class="px-1 text-xs font-semibold text-muted">{group}</p>
                <ul>
                  {services
                    .filter((service) => service.group === group)
                    .map((service) => (
                      <li>
                        <a href={service.href} class="block rounded-lg px-1 py-2 text-sm font-semibold hover:bg-paper">
                          {service.name}
                        </a>
                      </li>
                    ))}
                </ul>
              </div>
            ))
          }
          <p class="mt-4 px-1 text-xs font-bold uppercase tracking-wide text-teal">Service area</p>
          <a href="/locations" class="mt-1 block rounded-lg px-1 py-2 text-sm font-semibold hover:bg-paper">All areas</a>
          <ul>
            {
              footerTowns.map((town) => (
                <li>
                  <a href={town.href} class="block rounded-lg px-1 py-2 text-sm font-semibold hover:bg-paper">
                    {town.name}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 px-1 text-xs font-bold uppercase tracking-wide text-teal">Guides</p>
          <a href="/guides" class="mt-1 block rounded-lg px-1 py-2 text-sm font-semibold hover:bg-paper">All guides</a>
          <ul>
            {
              guides.map((guide) => (
                <li>
                  <a href={guide.href} class="block rounded-lg px-1 py-2 text-sm hover:bg-paper">
                    {guide.title}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="mt-3 border-t border-line pt-2">
            <a href="/about" class="block rounded-lg px-1 py-2 text-sm font-semibold hover:bg-paper">About</a>
            <a href="/contact" class="block rounded-lg px-1 py-2 text-sm font-semibold hover:bg-paper">Contact</a>
            <a href="/#quote" class="mt-2 btn btn-deep w-full">Request service</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
