---
interface Props {
  text: string;
}

const { text } = Astro.props;
const parts = text.split(/(\[[^\]]+\]\([^)\s]+\))/g);
---

{
  parts.map((part) => {
    const match = part.match(/^\[([^\]]+)\]\(([^)\s]+)\)$/);
    if (match && match[2].startsWith('/') && !match[2].startsWith('//')) {
      return (
        <a class="text-link" href={match[2]}>
          {match[1]}
        </a>
      );
    }
    return part;
  })
}
