---
import { SITE } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  track: string;
  channel?: 'tel' | 'sms';
  class?: string;
  label?: string;
  iconOnly?: boolean;
}

const { track, channel = 'tel', class: className, label, iconOnly = false } = Astro.props;
const enabled = channel === 'tel' || SITE.smsEnabled;
const href = channel === 'sms' ? SITE.smsHref : SITE.phoneHref;
const text =
  label ??
  (channel === 'sms' ? `Text ${SITE.phoneDisplay}` : `Call ${SITE.phoneDisplay}`);
---

{
  enabled && (
    <a
      href={href}
      class:list={[className]}
      data-track={track}
      data-contact-channel={channel}
      aria-label={iconOnly ? text : undefined}
    >
      <Icon name={channel === 'sms' ? 'chat' : 'phone'} class="h-5 w-5" />
      {!iconOnly && <span class="tabular-nums">{text}</span>}
    </a>
  )
}
