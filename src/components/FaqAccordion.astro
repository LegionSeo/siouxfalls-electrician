---
import InlineText from './InlineText.astro';

interface Item {
  q: string;
  a: string;
}

interface Props {
  items: Item[];
  heading?: string;
}

const { items, heading = 'Questions' } = Astro.props;
---

<section class="bg-paper" aria-labelledby="page-faq-heading">
  <div class="wrap section">
    <div class="faq-col">
      <div class="section-head">
        <h2 id="page-faq-heading">{heading}</h2>
      </div>
      <div class="faq">
        {
          items.map((item) => (
            <details>
              <summary class="flex items-center justify-between gap-4">
                <h2>{item.q}</h2>
                <span class="faq-plus text-2xl font-bold leading-none text-rose" aria-hidden="true">+</span>
                <span class="faq-minus text-2xl font-bold leading-none text-rose" aria-hidden="true">−</span>
              </summary>
              <p class="measure mt-3 text-muted">
                <InlineText text={item.a} />
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
