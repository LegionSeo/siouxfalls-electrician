---
import { SITE } from '../config/site';

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<label class="consent" for={id}>
  <input id={id} name="sms_consent" type="checkbox" value="yes" />
  <span>
    I agree to receive text messages from {SITE.name} about my service request and appointments. Message frequency
    varies. Msg and data rates may apply. Reply STOP to opt out or HELP for help. See our <a class="text-link" href="/privacy-policy">Privacy Policy</a>.
  </span>
</label>
