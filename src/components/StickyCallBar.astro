---
import { SITE } from '../config/site';
import ContactLink from './ContactLink.astro';
import Icon from './Icon.astro';
---

<div
  data-sticky-bar
  class="surface-dark fixed inset-x-0 bottom-0 z-[70] border-t border-white/15 bg-ink pb-[env(safe-area-inset-bottom)] lg:hidden"
>
  <div class="flex min-w-0 items-center gap-2 px-3 py-2">
    <ContactLink track="call-sticky" class="btn btn-copper h-12 min-h-12 min-w-0 flex-[2] px-3" />
    {
      SITE.smsEnabled ? (
        <ContactLink track="sms-sticky" channel="sms" class="btn btn-line h-12 min-h-12 min-w-0 flex-1 px-3" label="Text" />
      ) : (
        <a href={`mailto:${SITE.email}`} class="btn btn-line h-12 min-h-12 min-w-0 flex-1 px-3" data-track="email-sticky">
          <Icon name="mail" class="h-5 w-5" />
          <span>Email</span>
        </a>
      )
    }
  </div>
</div>
