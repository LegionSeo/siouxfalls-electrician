---
import { SITE } from '../config/site';
import ContactLink from './ContactLink.astro';
import Icon from './Icon.astro';
---

<div
  data-sticky-bar
  class="surface-dark fixed inset-x-0 bottom-0 z-[70] border-t border-white/15 bg-ink pb-[env(safe-area-inset-bottom)] lg:hidden"
>
  <div class="flex h-16 items-center gap-2 px-3">
    <ContactLink track="call-sticky" class="btn btn-copper h-12 min-h-12 flex-[2] px-3" />
    {
      SITE.smsEnabled ? (
        <ContactLink track="sms-sticky" channel="sms" class="btn btn-line h-12 min-h-12 flex-1 px-3" label="Text" />
      ) : (
        <a href="/#quote" class="btn btn-line h-12 min-h-12 flex-1 px-3">
          <Icon name="clipboard" class="h-5 w-5" />
          <span>Request service</span>
        </a>
      )
    }
  </div>
</div>
