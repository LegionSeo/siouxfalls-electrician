---
interface Props {
  src: string;
  title: string;
  label: string;
  class?: string;
}

const { src, title, label, class: className } = Astro.props;
---

<div class:list={['map-embed relative overflow-hidden rounded-2xl bg-ink', className]} data-map>
  <button
    type="button"
    class="absolute inset-0 flex cursor-pointer flex-col items-center justify-center gap-2 px-6 text-center text-white"
    data-map-load={src}
    data-map-title={title}
  >
    <span class="text-lg font-bold">Show map</span>
    <span class="max-w-[28ch] text-sm leading-relaxed text-mist">{label}</span>
  </button>
  <noscript>
    <iframe class="absolute inset-0 h-full w-full border-0" src={src} title={title} loading="lazy"></iframe>
  </noscript>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-map-load]').forEach((button) => {
    if (button.dataset.mapBound) return;
    button.dataset.mapBound = '1';
    button.addEventListener('click', () => {
      const src = button.dataset.mapLoad;
      const pane = button.closest('[data-map]');
      if (!src || !pane) return;
      const frame = document.createElement('iframe');
      frame.src = src;
      frame.title = button.dataset.mapTitle || 'Map';
      frame.loading = 'lazy';
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.setAttribute('allowfullscreen', '');
      frame.className = 'absolute inset-0 h-full w-full border-0';
      pane.replaceChildren(frame);
    });
  });
</script>
