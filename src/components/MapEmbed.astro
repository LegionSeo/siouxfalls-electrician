---
interface Props {
  src: string;
  title: string;
  label: string;
  preview: string;
  class?: string;
}

const { src, title, label, preview, class: className } = Astro.props;
---

<div class:list={['map-embed relative overflow-hidden rounded-2xl', className]} data-map>
  <img class="map-preview" src={preview} alt="" width="800" height="1000" decoding="async" />
  <button type="button" class="map-open" data-map-load={src} data-map-title={title}>
    <span>Show map</span>
    <span class="map-open-note">{label}</span>
  </button>
  <a class="map-credit" href="https://www.openstreetmap.org/copyright" rel="noopener noreferrer">
    © OpenStreetMap
  </a>
  <noscript>
    <iframe class="absolute inset-0 h-full w-full border-0" src={src} title={title} loading="lazy"></iframe>
  </noscript>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-map-load]').forEach((button) => {
    if (button.dataset.mapBound) return;
    button.dataset.mapBound = '1';
    button.addEventListener('click', () => {
      const src = button.dataset.mapLoad;
      const pane = button.closest('[data-map]');
      if (!src || !pane) return;
      const frame = document.createElement('iframe');
      frame.src = src;
      frame.title = button.dataset.mapTitle || 'Map';
      frame.loading = 'lazy';
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.setAttribute('allowfullscreen', '');
      frame.className = 'absolute inset-0 h-full w-full border-0';
      pane.replaceChildren(frame);
    });
  });
</script>
