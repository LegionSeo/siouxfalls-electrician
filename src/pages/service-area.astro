---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import MapEmbed from '../components/MapEmbed.astro';
import PageHero from '../components/PageHero.astro';
import { joinNames, services, townPages } from '../config/catalog';
import { UPDATED_LABEL } from '../content/updated';
import { breadcrumb } from '../lib/page-schema';
import { SITE } from '../config/site';

const liveTowns = townPages.filter((town) => town.live && town.href !== '/');
const liveServices = services.filter((service) => service.live).slice(0, 4);
const graph = [
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Service area', path: '/service-area' },
  ]),
];
---

<Layout
  title="Electrician Service Area Sioux Falls SD"
  description={`Towns served from Sioux Falls: ${joinNames(liveTowns.map((town) => town.name))}. ${joinNames(SITE.listOnlyTowns)} are listed as text only.`}
  fullTitle
  extraGraph={graph}
  overlay
>
  <PageHero
    photo={SITE.heroPhoto}
    eyebrow="Service area"
    title="Electrician Service Area Sioux Falls SD"
    sub="Each linked town has its own page."
  />

  <section class="bg-paper">
    <div class="wrap section">
      <p class="measure text-lg">
        Sioux Falls Electricians works in Sioux Falls and {joinNames(liveTowns.map((town) => town.name))}.
        Each of those towns has a page with the local facts that could be checked.
        {joinNames(SITE.listOnlyTowns)} appear here as plain text only. They do not have pages.
      </p>
      <p class="mt-6 text-sm text-muted">Updated {UPDATED_LABEL}</p>
    </div>
  </section>

  <section class="bg-white" aria-labelledby="towns-heading">
    <div class="wrap section">
      <h2 id="towns-heading">Town pages</h2>
      <ul class="mt-6 flex flex-wrap gap-2">
        <li><a class="town-chip" href="/">Sioux Falls</a></li>
        {liveTowns.map((town) => <li><a class="town-chip" href={town.href}>{town.name}</a></li>)}
      </ul>
      <h2 id="also-heading" class="mt-12">Also served, no page</h2>
      <p class="measure mt-4 text-muted">{joinNames(SITE.listOnlyTowns)}.</p>
    </div>
  </section>

  <section class="bg-paper" aria-labelledby="map-heading">
    <div class="wrap section">
      <div class="grid items-start gap-8 lg:grid-cols-2">
        <MapEmbed
          src="https://www.google.com/maps?q=Sioux+Falls,+SD&z=10&output=embed"
          title="Map of Sioux Falls, South Dakota and nearby towns"
          label="Sioux Falls and the towns around it"
          preview="/images/sioux-falls-area-preview.webp"
        />
        <div>
          <h2 id="map-heading">Common requests</h2>
          <ul class="mt-6 grid gap-3">
            {
              liveServices.map((service) => (
                <li>
                  <a class="text-link" href={service.href}>{service.name}</a>
                </li>
              ))
            }
          </ul>
          <p class="mt-6 text-sm text-muted">
            Building permits inside a city go to that city. Electrical inspections inside Sioux Falls are handled by the city.
            Other wiring inspections follow the South Dakota State Electrical Commission.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand photo={SITE.heroPhoto} heading="Call with the town and the problem" />
</Layout>
