---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import SideRail from '../../components/SideRail.astro';
import { guides } from '../../content/guides';
import { BRIEF_ISO } from '../../content/updated';
import { pagePhoto } from '../../lib/photos';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
const bodies = import.meta.glob<{ Content: any; compiledContent: () => Promise<string> }>(
  '../../content/guides/*.md',
  { eager: true },
);
const body = bodies[`../../content/guides/${guide.slug}.md`];
const Content = body.Content;
const ctaPhoto = pagePhoto('hero-about', 'Electrical contractor van parked in a residential driveway, side door open, no people');
// Keep this post's apostrophes and quotes as written so the visible FAQs match the JSON-LD.
const exactHtml =
  guide.slug === 'lights-flickering-in-house'
    ? (await body.compiledContent())
        .replaceAll('\u2018', "'")
        .replaceAll('\u2019', "'")
        .replaceAll('\u201C', '"')
        .replaceAll('\u201D', '"')
    : '';
---

<Layout title={guide.title} description={guide.description} fullTitle dateModified={guide.dateModified ?? (guide.slug === 'outlet-not-working' ? BRIEF_ISO : undefined)}>
  <Fragment slot="head">
    {guide.schema.map((node) => <script type="application/ld+json" set:html={JSON.stringify(node)} />)}
  </Fragment>

  <div class="page-split">
    <div class="page-main">
      <section class="bg-paper">
        <div class="section">
          <nav class="guide-crumbs text-sm text-muted" aria-label="Breadcrumb">
            <a class="text-link" href="/">Home</a>{" "}<span aria-hidden="true">/</span>{" "}
            <a class="text-link" href="/guides">Guides</a>
          </nav>
          <article class="guide-prose measure">
            <h1>{guide.h1}</h1>
            {exactHtml ? <Fragment set:html={exactHtml} /> : <Content />}
            {
              guide.related && (
                <p>
                  See <a href={guide.related.href}>{guide.related.label}</a>.
                </p>
              )
            }
          </article>
        </div>
      </section>
    </div>
    <SideRail />
  </div>

  <CtaBand photo={ctaPhoto} heading="Call with the problem" />
</Layout>
