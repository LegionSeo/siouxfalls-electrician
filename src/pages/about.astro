---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import PageHero from '../components/PageHero.astro';
import SideRail from '../components/SideRail.astro';
import { joinNames, services, townPages } from '../config/catalog';
import { UPDATED_ISO, UPDATED_LABEL } from '../content/updated';
import { pagePhoto } from '../lib/photos';
import { SITE, formatAddress } from '../config/site';

const liveServices = services.filter((service) => service.live);
const liveTowns = townPages.filter((town) => town.live && town.href !== '/');
const hero = pagePhoto('hero-about', 'Electrical contractor van parked in a residential driveway, side door open, no people');
const faqs = [
  {
    q: 'Where is the shop?',
    a: `The published address is ${formatAddress()}. Call before you come by, so someone expects you.`,
  },
  {
    q: 'How do I ask for work?',
    a: `Call ${SITE.phoneDisplay} or use the contact page.`,
  },
];
---

<Layout
  title="About Sioux Falls Electricians"
  description={`About ${SITE.name}: residential and commercial electrical work in Sioux Falls and nearby towns. Call ${SITE.phoneDisplay}.`}
  fullTitle
  overlay
>
  <PageHero
    photo={hero}
    eyebrow={SITE.name}
    title="About Sioux Falls Electricians"
    sub="Residential and commercial electrical work in Sioux Falls and the towns around it."
  />

  <div class="page-split">
    <div class="page-main">
      <section class="bg-paper">
        <div class="section">
          <p class="measure text-lg">
            {SITE.name} does residential and commercial electrical work in Sioux Falls and the towns on the service area page.
            The work is repairs, panel upgrades, wiring, lighting, EV chargers, and the other services listed on this site.
          </p>
          <p class="mt-4 measure text-muted">
            {SITE.available247 ? SITE.availabilityNote : ''} The phone number on this site is {SITE.phoneDisplay}. It is the only number to use.
          </p>
          <p class="mt-6 text-sm text-muted">Updated <time datetime={UPDATED_ISO}>{UPDATED_LABEL}</time></p>
        </div>
      </section>

      <section class="bg-white" aria-labelledby="work-heading">
        <div class="section">
          <div class="block-head">
            <h2 id="work-heading">What this site covers</h2>
          </div>
          <ul class="card-grid cols-2">
            {
              liveServices.map((service) => (
                <li>
                  <a class="text-card" href={service.href}>
                    {service.name}
                    <span class="mt-2 block text-sm font-normal text-muted">{service.summary}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="bg-paper" aria-labelledby="area-heading">
        <div class="section">
          <div class="block-head">
            <h2 id="area-heading">Where the calls come from</h2>
            <p class="lede">
              Sioux Falls is home. {joinNames(liveTowns.map((town) => town.name))} are the other towns with pages.
            </p>
          </div>
          <p>
            <a class="text-link" href="/service-area">Read the service area page</a>
          </p>
        </div>
      </section>

      <FaqAccordion items={faqs} heading="About these pages" />
    </div>
    <SideRail />
  </div>

  <CtaBand photo={hero} heading="Call with the problem" />
</Layout>
