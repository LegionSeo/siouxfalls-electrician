---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import PageHero from '../components/PageHero.astro';
import SideRail from '../components/SideRail.astro';
import { joinNames, services, townPages } from '../config/catalog';
import { UPDATED_ISO, UPDATED_LABEL } from '../content/updated';
import { pagePhoto } from '../lib/photos';
import { breadcrumb } from '../lib/page-schema';
import { OPERATOR_EMAIL, REFERRAL_DISCLOSURE, SITE, formatAddress } from '../config/site';

const liveServices = services.filter((service) => service.live);
const liveTowns = townPages.filter((town) => town.live && town.href !== '/');
const hero = pagePhoto('hero-about', 'Van parked in a residential driveway, side door open, no people');
const faqs = [
  {
    q: 'Where are you located?',
    a: `Midwest Leads LLC is based in Sioux Falls, SD. The published place is ${formatAddress()}. Call or email if you want a reply about a referral.`,
  },
  {
    q: 'How do I ask for an electrician?',
    a: `Call ${SITE.phoneDisplay} or use the contact page. Tell us your town, the room, and what stopped working. We connect you with a local licensed electrician.`,
  },
];
const graph = [
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about' },
  ]),
];
---

<Layout
  title="About Us | Sioux Falls Electricians, Sioux Falls, SD"
  schemaName="About Sioux Falls Electricians"
  description={`About ${SITE.name}: a referral service operated by Midwest Leads LLC in Sioux Falls, SD. We connect you with a local licensed electrician. Call ${SITE.phoneDisplay}.`}
  fullTitle
  extraGraph={graph}
  overlay
>
  <PageHero
    photo={hero}
    eyebrow={SITE.name}
    title="About Sioux Falls Electricians"
    sub="A referral service that connects you with a local licensed electrician in Sioux Falls and nearby towns."
  />

  <div class="page-split">
    <div class="page-main">
      <section class="bg-paper">
        <div class="section">
          <p class="measure text-lg">{REFERRAL_DISCLOSURE}</p>
          <p class="mt-4 measure">
            Call {SITE.phoneDisplay} or submit a request. We connect you with a local licensed electrician for repairs, panel upgrades, wiring, lighting, EV chargers, and the other services listed on this site.
          </p>
          <p class="mt-4 measure text-muted">
            {SITE.available247 ? SITE.availabilityNote : ''} The phone number on this site is {SITE.phoneDisplay}. It is the only number to use.
            Email <a class="text-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
            or <a class="text-link" href={`mailto:${OPERATOR_EMAIL}`}>{OPERATOR_EMAIL}</a>.
          </p>
          <p class="mt-6 text-sm text-muted">Updated <time datetime={UPDATED_ISO}>{UPDATED_LABEL}</time></p>
        </div>
      </section>

      <section class="bg-white" aria-labelledby="work-heading">
        <div class="section">
          <div class="block-head">
            <h2 id="work-heading">What this site covers</h2>
            <p class="lede">Each name below opens its own page. You can read the work a matched electrician can do for your house or your business.</p>
          </div>
          <ul class="card-grid cols-2">
            {
              liveServices.map((service) => (
                <li>
                  <a class="text-card" href={service.href}>
                    {service.name}
                    <span class="mt-2 block text-sm font-normal text-muted">{service.summary}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="bg-paper" aria-labelledby="area-heading">
        <div class="section">
          <div class="block-head">
            <h2 id="area-heading">Where the calls come from</h2>
            <p class="lede">
              Sioux Falls is home. {joinNames(liveTowns.map((town) => town.name))} are the other towns with pages.
            </p>
          </div>
          <p>
            <a class="text-link" href="/service-area">Read the service area page</a>
          </p>
        </div>
      </section>

      <FaqAccordion items={faqs} heading="About these pages" />
    </div>
    <SideRail />
  </div>

  <CtaBand photo={hero} heading="Call with the problem" />
</Layout>
