---
import Layout from '../../layouts/Layout.astro';
import { townPages } from '../../config/catalog';
import { SITE } from '../../config/site';
import { Icon } from 'astro-icon/components';

const phone = SITE.phoneDisplay;
const linkClass = 'text-link';

const chargerLevels = [
  {
    icon: 'ph:plug',
    title: 'Level 1',
    tag: 'Standard outlet',
    points: [
      'Plugs into a normal wall outlet.',
      'Needs no special equipment.',
      'Charges slowly, often a few miles of range each hour.',
      'Works for short daily drives and overnight charging.',
    ],
  },
  {
    icon: 'ph:lightning',
    title: 'Level 2',
    tag: '240 volt circuit',
    points: [
      'Uses a 240 volt circuit, like a dryer or range.',
      'Charges several times faster than Level 1.',
      'Most drivers wake up to a full battery.',
      'The better fit for daily driving.',
    ],
  },
];

const installSteps = [
  'Look at your panel, your parking spot, and where the charger will go.',
  'Run a new 240 volt circuit from the panel to the charger location.',
  'Mount the charger and pull the permit so the work meets code.',
  'Test everything and make sure it is ready to pass inspection.',
];

const locations = townPages
  .filter((town) => town.live && town.href !== '/')
  .map((town) => ({ label: town.name, href: town.href }));

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'EV Charger Installation',
  provider: { '@id': '#business' },
  areaServed: ['Sioux Falls', 'Brandon', 'Harrisburg', 'Tea'],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.origin },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'EV Charger Installation',
      item: `${SITE.origin}/services/ev-charger-installation`,
    },
  ],
};
---

<Layout
  title="EV Charger Installation Sioux Falls SD | Home Charging"
  fullTitle
  description={`EV charger installation in Sioux Falls. We install Level 2 home chargers and check your panel capacity. Call ${SITE.phoneDisplay} to get started.`}
  canonical={`${SITE.origin}/services/ev-charger-installation`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="border-b border-brand-grey bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12 lg:py-16">
      <nav aria-label="Breadcrumb" class="text-sm">
        <ol class="flex items-center gap-2 copy-faint">
          <li><a href="/" class="text-link">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="font-semibold text-brand-charcoal">EV Charger Installation</li>
        </ol>
      </nav>
      <span class="mt-6 inline-flex items-center gap-2 rounded-full bg-brand-grey px-3 py-1 text-sm font-semibold copy-soft">
        <Icon name="ph:car" class="h-4 w-4" />
        Home and business charging
      </span>
      <h1 class="mt-4 max-w-3xl svc-hero">
        EV Charger Installation in Sioux Falls, SD
      </h1>
      <p class="mt-5 max-w-xl text-lg copy-muted">
        Charge your electric vehicle at home with a charger sized for your car, your garage, and your daily driving.
      </p>
      <a
        href={SITE.phoneHref} data-track="call-page" data-contact-channel="tel"
        class="btn-pill"
      >
        <Icon name="ph:phone-fill" class="h-5 w-5" />
        Call {phone}
      </a>
    </div>
  </section>

  <!-- Level 1 versus Level 2 -->
  <section class="bg-brand-grey">
    <div class="mx-auto max-w-6xl px-4 py-16 lg:py-20">
      <h2 class="svc-title">Level 1 versus Level 2 explained</h2>
      <p class="mt-3 max-w-2xl copy-muted">
        Home charging comes in two levels, and the difference matters. For most people who drive every day, a Level 2
        charger is the better fit. We help you decide based on your car and how far you drive.
      </p>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {chargerLevels.map((level) => (
          <div class="rounded-2xl bg-white p-8">
            <div class="flex items-center gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-yellow">
                <Icon name={level.icon} class="h-7 w-7 text-brand-charcoal" />
              </span>
              <div>
                <h3 class="text-lg font-bold">{level.title}</h3>
                <p class="text-sm copy-faint">{level.tag}</p>
              </div>
            </div>
            <ul class="mt-6 stack-md">
              {level.points.map((point) => (
                <li class="flex items-start gap-3 text-sm copy-soft">
                  <Icon name="ph:check-circle-fill" class="mt-0.5 h-5 w-5 shrink-0 text-brand-yellow" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What the install involves -->
  <section class="mx-auto max-w-6xl px-4 py-16 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <h2 class="svc-title">What the install involves</h2>
        <p class="mt-4 max-w-md copy-muted">
          A Level 2 install is a real electrical project, not a plug and play job. Most home installs are done in a day.
        </p>
        <p class="mt-4 max-w-md copy-muted">
          If your existing <a href="/services/wiring-rewiring" class={linkClass}>wiring</a> makes the run tricky, we
          explain your options before we start, so there are no surprises.
        </p>
      </div>
      <ol class="stack">
        {installSteps.map((step, index) => (
          <li class="flex items-start gap-4 rounded-2xl border border-brand-grey p-5">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-yellow font-bold text-brand-charcoal">
              {index + 1}
            </span>
            <span class="copy-soft">{step}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Does your panel have capacity -->
  <section class="mx-auto max-w-6xl px-4 pb-16 lg:pb-20">
    <div class="rounded-3xl bg-brand-charcoal px-6 py-12 text-white sm:px-12">
      <h2 class="max-w-2xl svc-title">Does your panel have capacity?</h2>
      <div class="mt-6 grid gap-6 on-dark md:grid-cols-2">
        <p>
          Before adding a charger, we check whether your panel can handle the extra load. A car charger pulls a lot of
          power, and not every panel has room to spare. We measure your current service and give you a straight answer
          about what your panel can support.
        </p>
        <p>
          If your panel is older or already full, we may recommend a
          <a href="/services/panel-upgrades" class="text-link-on-dark">panel upgrade</a>
          first. That step makes sure your charger runs safely and does not overload the rest of your home. Sometimes
          there is plenty of room, and sometimes an upgrade is the smart first move.
        </p>
      </div>
    </div>
  </section>

  <!-- Garage and driveway options -->
  <section class="bg-brand-grey">
    <div class="mx-auto max-w-6xl px-4 py-16 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <h2 class="svc-title">Garage and driveway options</h2>
        <div class="stack copy-muted">
          <p>
            Where you park changes how we approach the job. In an attached garage, the run from the panel is often short
            and simple. For a detached garage or a driveway spot, we plan a safe route for the wiring and use equipment
            rated for the outdoors.
          </p>
          <p>
            We can mount the charger on a wall or a post, depending on your setup. If you are not sure where the charger
            should go, we walk the space with you and find a spot that is easy to use and out of the way.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Commercial and multi unit charging -->
  <section class="mx-auto max-w-6xl px-4 py-16 lg:py-20">
    <div class="max-w-3xl">
      <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-yellow">
        <Icon name="ph:buildings" class="h-7 w-7 text-brand-charcoal" />
      </span>
      <h2 class="mt-5 svc-title">Commercial and multi unit charging</h2>
      <p class="mt-4 copy-muted">
        Charging is not just for single family homes. Workplaces, apartments, and other properties are adding chargers
        for staff, tenants, and customers. These projects take more planning, since they often need several chargers and
        a bigger power supply.
      </p>
      <p class="mt-4 copy-muted">
        Our <a href="/services/commercial-electrician" class={linkClass}>commercial electrical</a> team handles the
        layout, the load, and the equipment for jobs like these. Whether you need one charger for a small office or
        several for a parking lot, we can scope the work and build it to last.
      </p>
    </div>
  </section>

  <!-- Service area -->
  <section class="bg-brand-grey">
    <div class="mx-auto max-w-6xl px-4 py-16 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <h2 class="svc-title">Charger installs near you</h2>
          <p class="mt-4 max-w-md copy-muted">
            We install EV chargers for homes and businesses in Sioux Falls and the surrounding towns. See the rest of
            what we do on our <a href="/" class={linkClass}>Sioux Falls electrician</a> page, or pick your area below.
          </p>
        </div>
        <ul class="grid gap-4 sm:grid-cols-3">
          {locations.map((location) => (
            <li>
              <a
                href={location.href}
                class="loc-card"
              >
                <span class="flex items-center gap-3 font-bold">
                  <Icon name="ph:map-pin" class="h-6 w-6 text-brand-charcoal" />
                  {location.label}
                </span>
                <Icon name="ph:arrow-right" class="loc-arrow" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Final call to action -->
  <section class="mx-auto max-w-6xl px-4 py-16 lg:py-20">
    <div class="rounded-3xl bg-brand-charcoal px-6 py-14 text-center text-white sm:px-12">
      <h2 class="svc-title">Ready to charge at home?</h2>
      <p class="mx-auto mt-4 max-w-xl on-dark">
        Call us and we will help you pick the right charger and get it installed.
      </p>
      <a
        href={SITE.phoneHref} data-track="call-page" data-contact-channel="tel"
        class="btn-pill btn-pill-lg"
      >
        <Icon name="ph:phone-fill" class="h-5 w-5" />
        Call {phone}
      </a>
    </div>
  </section>
</Layout>
