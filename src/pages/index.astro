---
import Layout from '../layouts/Layout.astro';
import ContactLink from '../components/ContactLink.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import RequestPanel from '../components/RequestPanel.astro';
import { joinNames, services, townPages } from '../config/catalog';
import { SITE, mapsUrl } from '../config/site';
import { homepageFaqs } from '../content/home';
import { faqNode } from '../lib/schema';

const faqs = homepageFaqs();
const homeTitle = 'Electrician Referrals in Sioux Falls, SD | Sioux Falls Electricians';
const homeSchemaName = 'Electrician Referrals in Sioux Falls, SD | Sioux Falls Electricians';
const homeDescription = `Need an electrician in Sioux Falls? ${SITE.name} is a referral service that connects you with a local licensed electrician for homes and businesses in Sioux Falls, Brandon, Harrisburg, Tea, and nearby towns. Calls answered 24/7. Call ${SITE.phoneDisplay}.`;

const featuredHrefs = [
  '/services/electrical-repair',
  '/services/emergency-electrician',
  '/services/panel-upgrades',
  '/services/ev-charger-installation',
  '/services/lighting-installation',
  '/services/commercial-electrician',
];

const featured = featuredHrefs.map((href) => {
  const service = services.find((item) => item.href === href);
  const photo = SITE.servicePhotos[href];
  if (!service || !photo) throw new Error(`Missing featured service ${href}`);
  return { service, photo };
});

const moreServices = services.filter((service) => !featuredHrefs.includes(service.href));
const homePhoto = SITE.servicePhotos['/services/lighting-installation'];
const businessPhoto = SITE.servicePhotos['/services/commercial-electrician'];
const cardSizes = '(min-width: 1024px) 360px, (min-width: 700px) 45vw, 100vw';
const eyebrow = SITE.available247 ? '24/7 · Sioux Falls & nearby towns' : 'Sioux Falls & nearby towns';

const areaMapSrc = 'https://maps.google.com/maps?ll=43.5460,-96.7313&z=8&t=m&hl=en&output=embed';

const steps = [
  {
    title: SITE.smsEnabled ? 'Call or text' : 'Call',
    text: 'Call and tell us what happened. Say which room, and whether it is your house or your business.',
  },
  {
    title: 'We match you',
    text: 'We connect you with a local licensed electrician who starts in the room you describe and checks the device, the wires, and the breaker before replacing anything.',
  },
  {
    title: 'The electrician does the work',
    text: "The electrician you're matched with pulls a permit when your city requires one. Before they leave, they show you what they worked on.",
  },
];
---

<Layout title={homeTitle} schemaName={homeSchemaName} description={homeDescription} fullTitle extraGraph={[faqNode(faqs)]} overlay>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/images/hero-electrician-panel-1280.avif"
    imagesrcset={SITE.heroPhoto.avifSrcset}
    imagesizes="100vw"
    type="image/avif"
    fetchpriority="high"
  />

  <section class="hero hero-home surface-dark">
    <div class="hero-media">
      <Photo
        photo={SITE.heroPhoto}
        pictureClass="hero-picture"
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="hero-img"
      />
      <div class="hero-shade" aria-hidden="true"></div>
    </div>
    <div class="wrap hero-copy">
      <p class="eyebrow eyebrow-on-dark">{eyebrow}</p>
      <h1>
        Electrician referrals in<br />
        Sioux Falls, SD
      </h1>
      <p class="hero-sub">
        {SITE.name} connects you with a local licensed electrician for homes and businesses. Repairs, panel upgrades, EV chargers, and lighting at home. Lighting, circuits, and panels for shops and offices{SITE.available247 ? '. Calls answered 24/7' : ''}.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <ContactLink track="call-hero" class="btn btn-gold w-full sm:w-auto" />
        <a href="#quote" class="btn btn-line w-full sm:w-auto">
          <Icon name="arrow" class="h-5 w-5" />
          Request service
        </a>
      </div>
      <ul class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          SITE.available247 && (
            <li class="flex items-start gap-3 text-sm font-semibold">
              <Icon name="phone" class="mt-0.5 h-6 w-6 shrink-0 text-rose" />
              <span>24/7 calls</span>
            </li>
          )
        }
        <li class="flex items-start gap-3 text-sm font-semibold">
          <Icon name="check" class="mt-0.5 h-6 w-6 shrink-0 text-rose" />
          <span>Repairs and panel work</span>
        </li>
        <li class="flex items-start gap-3 text-sm font-semibold">
          <Icon name="home" class="mt-0.5 h-6 w-6 shrink-0 text-rose" />
          <span>Homes and businesses</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="bg-white" aria-label="Trust and quick answer">
    <div class="wrap section">
      <ul class="trust-grid">
        <li>
          <span class="icon-chip">
            <Icon name="phone" />
          </span>
          <p class="mt-3 font-bold">{SITE.available247 ? '24/7 answered' : 'Calls answered'}</p>
          <p class="mt-1 text-sm text-muted">
            {SITE.available247
              ? 'Call any time, day or night. If you smell burning or a switch feels hot, tell us right away.'
              : 'Call and tell us what is going on. If you smell burning or a switch feels hot, say so right away.'}
          </p>
        </li>
        <li>
          <span class="icon-chip">
            <Icon name="check" />
          </span>
          <p class="mt-3 font-bold">Houses and shops</p>
          <p class="mt-1 text-sm text-muted">Homeowners and business owners call the same number. We connect either one with a local licensed electrician.</p>
        </li>
        <li>
          <span class="icon-chip">
            <Icon name="wrench" />
          </span>
          <p class="mt-3 font-bold">Permitted work</p>
          <p class="mt-1 text-sm text-muted">
            The electrician you're matched with pulls permits when the city requires them. New circuits and panel changes are the jobs that usually need one.
          </p>
        </li>
        <li>
          <span class="icon-chip">
            <Icon name="pin" />
          </span>
          <p class="mt-3 font-bold">{SITE.serviceTowns.length} towns covered</p>
          <p class="mt-1 text-sm text-muted">We take requests in Sioux Falls and the towns around it. Open a town page to see the jobs a matched electrician does there.</p>
        </li>
      </ul>
      <div class="mt-12 max-w-[65ch]">
        <p class="eyebrow">Quick answer</p>
        <p>
          Sioux Falls Electricians connects you with a local licensed electrician for repairs, panel upgrades, EV chargers, lighting, and wiring for homes and businesses in Sioux Falls and nearby towns.{SITE.available247 ? ` ${SITE.availabilityNote}` : ''} Call {SITE.phoneDisplay}.
        </p>
      </div>
    </div>
  </section>

  <section id="services" class="bg-paper" aria-labelledby="services-heading">
    <div class="wrap section">
      <div class="section-head">
        <h2 id="services-heading">Electrical services in Sioux Falls</h2>
        <p class="lede">
          Pick the job that matches the problem. Homes and businesses use the same phone number.
        </p>
      </div>
      <h3 class="more-label">Most requested</h3>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          featured.map(({ service, photo }) => (
            <li>
              <a href={service.href} class="card">
                <Photo photo={photo} sizes={cardSizes} loading="lazy" class="aspect-[4/3] w-full object-cover" />
                <span class="flex flex-1 flex-col p-5">
                  <h3>{service.name}</h3>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{service.summary}</p>
                  <span class="mt-4 text-sm font-semibold text-rose">Learn more →</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <h3 class="more-label">More services</h3>
      <ul class="more-grid">
        {
          moreServices.map((service) => {
            const Tag = service.live ? 'a' : 'div';
            return (
              <li>
                <Tag href={service.live ? service.href : undefined} class="more-row">
                  <Icon name={service.icon} class="more-icon" />
                  <span>
                    <span class="more-title">{service.name}</span>
                    <span class="more-line">{service.summary}</span>
                    {service.live && <span class="more-go">Learn more</span>}
                  </span>
                </Tag>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="bg-white" aria-labelledby="help-heading">
    <div class="wrap section">
      <div class="section-head">
        <h2 id="help-heading">Residential and commercial electrician in Sioux Falls</h2>
        <p class="lede">Call us for your house or your business. Tell us which one so the electrician you're matched with shows up ready for that building.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        <a href="#services" class="split-panel">
          <Photo photo={homePhoto} pictureClass="hero-picture" sizes="(min-width: 768px) 50vw, 100vw" loading="lazy" class="hero-img split-home" />
          <span class="split-shade" aria-hidden="true"></span>
          <span class="relative flex flex-1 flex-col justify-end p-8">
            <h3 class="text-white">For your home</h3>
            <p class="mt-3 max-w-[36ch] on-dark-soft">
              Outlets, panels, lights, EV chargers, and wiring in your house. Call us for one bad outlet or for a bigger job. We connect you with a local licensed electrician.
            </p>
            <span class="btn btn-line mt-6 w-fit">See home services</span>
          </span>
        </a>
        <a href="/services/commercial-electrician" class="split-panel">
          <Photo photo={businessPhoto} pictureClass="hero-picture" sizes="(min-width: 768px) 50vw, 100vw" loading="lazy" class="hero-img split-biz" />
          <span class="split-shade" aria-hidden="true"></span>
          <span class="relative flex flex-1 flex-col justify-end p-8">
            <h3 class="text-white">For your business</h3>
            <p class="mt-3 max-w-[36ch] on-dark-soft">
              Lights and circuits for your shop, office, or other building. The electrician you're matched with can come when you can turn the equipment off.
            </p>
            <span class="btn btn-line mt-6 w-fit">Commercial electrician</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="surface-dark bg-ink text-white" aria-labelledby="process-heading">
    <div class="wrap section">
      <div class="section-head">
        <h2 id="process-heading" class="text-white">How it works</h2>
        <p class="lede on-dark">You call, we connect you with a local licensed electrician, and that electrician does the work. Your house and your business follow the same steps.</p>
      </div>
      <ol class="grid gap-8 md:grid-cols-3">
        {
          steps.map((step, index) => (
            <li>
              <span class="step-num">{index + 1}</span>
              <h3 class="mt-4 text-white">{step.title}</h3>
              <p class="mt-2 on-dark">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="service-area" class="bg-white" aria-labelledby="area-heading">
    <div class="wrap section">
      <div class="section-head">
        <h2 id="area-heading">Electrician referrals for Sioux Falls and nearby towns</h2>
        <div class="lede stack-md">
          <p>
            Older central neighborhoods, including the Cathedral Historic District, often still have older wiring. Newer subdivisions to the south and east are a different kind of job. Downtown sits between those areas.
          </p>
          <p>
            Looking for an electrician near you outside the city? {joinNames(townPages.filter((town) => town.live && town.href !== '/').map((town) => town.name))} have their own pages.
          </p>
        </div>
      </div>
      <div class="area-grid">
        <div class="area-map">
          <div class="home-map-frame">
            <iframe
              class="home-map"
              src={areaMapSrc}
              title="Map of Sioux Falls, South Dakota and nearby towns"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
              width="800"
              height="600"
            ></iframe>
          </div>
          <a class="home-map-link text-link" href={mapsUrl()} target="_blank" rel="noopener noreferrer">
            Open in Google Maps
          </a>
        </div>
        <ul class="area-towns">
          {
            townPages.map((town) =>
              town.live ? (
                <li>
                  <a class="town-chip" href={town.href}>
                    <Icon name="pin" class="h-4 w-4" />
                    {town.name}
                  </a>
                </li>
              ) : (
                <li>
                  <span class="town-chip">
                    <Icon name="pin" class="h-4 w-4" />
                    {town.name}
                  </span>
                </li>
              ),
            )
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="faq" class="bg-paper" aria-labelledby="faq-heading">
    <div class="wrap section">
      <div class="faq-col">
      <div class="section-head">
        <h2 id="faq-heading">Sioux Falls electrician FAQ</h2>
        <p class="lede">Here are the questions we hear most. If yours is not here, just call.</p>
      </div>
      <div class="faq">
        {
          faqs.map((item) => (
            <details>
              <summary class="flex items-center justify-between gap-4">
                <h3 class="text-lg">{item.question}</h3>
                <span class="faq-plus text-2xl font-bold leading-none text-rose" aria-hidden="true">+</span>
                <span class="faq-minus text-2xl font-bold leading-none text-rose" aria-hidden="true">−</span>
              </summary>
              {item.paragraphs.map((paragraph) => (
                <p class="measure mt-3 text-muted">{paragraph}</p>
              ))}
            </details>
          ))
        }
      </div>
      </div>
    </div>
  </section>

  <section id="quote" class="surface-dark relative overflow-hidden bg-ink text-white">
    <Photo
      photo={SITE.heroPhoto}
      pictureClass="hero-picture opacity-30"
      sizes="100vw"
      loading="lazy"
      class="hero-img"
    />
    <div class="absolute inset-0 ink-shade" aria-hidden="true"></div>
    <div class="wrap section relative">
      <h2 class="max-w-[22ch] text-white">Need a Sioux Falls electrician now?</h2>
      <p class="mt-4 max-w-[46ch] on-dark-soft">Tell us the room and what stopped working. Your house and your business can both use this number.</p>
      <div class="mt-12 flex flex-col gap-3 sm:flex-row sm:items-center">
        <ContactLink track="call-quote" class="btn btn-gold w-full sm:w-auto" />
        {
          SITE.smsEnabled ? (
            <ContactLink track="sms-quote" channel="sms" class="btn btn-line w-full sm:w-auto" label="Text" />
          ) : (
            <p class="on-dark-soft">
              <span>Prefer to write?</span>
              <a class="ml-1 font-semibold text-white underline" href={`mailto:${SITE.email}`} data-track="email-quote">
                Email {SITE.email}
              </a>
            </p>
          )
        }
      </div>
      {
        SITE.formEndpoint && (
          <div class="mt-8 max-w-xl rounded-2xl bg-white p-6 text-text">
            <RequestPanel
              heading="Request service"
              headingTag="p"
              intro="Describe the problem."
              callTrack="call-quote-form"
              smsTrack="sms-quote-form"
              formIdPrefix="quote"
            />
          </div>
        )
      }
    </div>
  </section>

  {
    SITE.jobPhotos.length > 0 && (
      <section class="wrap section" aria-label="Job photos">
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {SITE.jobPhotos.map((photo) => (
            <li>
              <img
                src={photo.src}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                class="h-auto w-full rounded-2xl"
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
