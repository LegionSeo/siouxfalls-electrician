---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import SideRail from '../components/SideRail.astro';
import { BRIEF_ISO } from '../content/updated';
import { SITE } from '../config/site';
import { breadcrumb } from '../lib/page-schema';

const title = 'Electrical Tools and Cost Guides | Sioux Falls Electricians';
const description = `Free tools for Sioux Falls homeowners: a rough electrical cost calculator and a generator size calculator. Call ${SITE.phoneDisplay} for a real quote.`;

const tools = [
  {
    href: '/tools/electrical-cost-calculator',
    title: 'Electrical cost calculator',
    text: 'Pick a job and see a rough low, typical, and high range from published national guides.',
    icon: 'clipboard',
  },
  {
    href: '/tools/generator-size-calculator',
    title: 'Generator size calculator',
    text: 'Match a home size and what you want running to a rough kilowatt range and generator cost.',
    icon: 'bolt',
  },
];

const graph = [
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Tools', path: '/tools' },
  ]),
  {
    '@type': 'ItemList',
    name: 'Electrical tools for Sioux Falls homeowners',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Sioux Falls Electrical Cost Calculator',
        url: `${SITE.origin}/tools/electrical-cost-calculator`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Generator Size Calculator',
        url: `${SITE.origin}/tools/generator-size-calculator`,
      },
    ],
  },
];
---

<Layout title={title} description={description} fullTitle schemaName={title} extraGraph={graph} dateModified={BRIEF_ISO}>
  <div class="page-split">
    <div class="page-main">
      <section class="bg-paper">
        <div class="section">
          <nav class="guide-crumbs text-sm text-muted" aria-label="Breadcrumb">
            <a class="text-link" href="/">Home</a>{' '}<span aria-hidden="true">/</span>{' '}Tools
          </nav>
          <div class="block-head mt-6">
            <h1>Electrical Tools for Sioux Falls Homeowners</h1>
            <p class="lede">
              Two free tools for a rough start. They use published national ranges, not a quote. Call {SITE.phoneDisplay} when you want a price for your house.
            </p>
          </div>
          <ul class="card-grid cols-2">
            {
              tools.map((tool) => (
                <li>
                  <a class="text-card" href={tool.href}>
                    <span class="icon-chip">
                      <Icon name={tool.icon} />
                    </span>
                    <span class="mt-4 block font-bold">{tool.title}</span>
                    <span class="mt-2 block text-sm font-normal text-muted">{tool.text}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="measure mt-8">
            For a step by step check you can do yourself, see the <a class="text-link" href="/guides">electrical guides</a>.
          </p>
        </div>
      </section>
    </div>
    <SideRail />
  </div>
</Layout>
