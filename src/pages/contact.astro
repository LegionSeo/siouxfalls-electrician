---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { townPages } from '../config/catalog';
import { SITE, formatAddress } from '../config/site';
import { pagePhoto } from '../lib/photos';

const hero = pagePhoto('hero-contact', 'Shop counter with a desk phone and a blank notepad');

const towns = ['Sioux Falls', ...townPages.filter((town) => town.href !== '/').map((town) => town.name), ...SITE.listOnlyTowns];
---

<Layout
  title="Contact Sioux Falls Electricians"
  description={`Call ${SITE.phoneDisplay}, text, or send a short note to ${SITE.name}. ${formatAddress()}.`}
  fullTitle
  overlay
>
  <PageHero
    photo={hero}
    eyebrow="Contact"
    title="Contact Sioux Falls Electricians"
    sub="Call, text, or send a short note. You get a written quote before work starts."
    actions="reach"
  />

  <section class="bg-paper">
    <div class="wrap section">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <h2>Call or text</h2>
          <p class="measure mt-4 text-muted">
            The number comes from the site config. Use it for a house or a business. You get a written quote before work starts.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:max-w-sm">
            <a class="btn btn-copper" href={SITE.phoneHref} data-track="call-contact" data-contact-channel="tel">
              <Icon name="phone" class="h-5 w-5" />
              <span>Call {SITE.phoneDisplay}</span>
            </a>
            <a class="btn btn-line-dark" href={SITE.smsHref} data-track="sms-contact" data-contact-channel="sms">
              <Icon name="chat" class="h-5 w-5" />
              <span>Text {SITE.phoneDisplay}</span>
            </a>
          </div>
          <p class="mt-6 text-sm text-muted">
            Email <a class="text-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
          <address class="mt-4 text-sm not-italic text-muted">{formatAddress()}</address>
        </div>

        <div>
          <h2>Short note</h2>
          <p class="mt-4 text-muted">Name, phone, town, and what failed. If a form address is set, the note is posted there. Otherwise it opens in your email app.</p>
          <form
            class="mt-6 grid gap-4"
            method="post"
            action={SITE.formEndpoint ?? undefined}
            data-request-form
            data-mail={SITE.email}
          >
            <label class="grid gap-1 text-sm font-semibold" for="contact-name">
              Name
              <input class="field" id="contact-name" name="name" type="text" required autocomplete="name" />
            </label>
            <label class="grid gap-1 text-sm font-semibold" for="contact-phone">
              Phone
              <input class="field" id="contact-phone" name="phone" type="tel" required autocomplete="tel" />
            </label>
            <label class="grid gap-1 text-sm font-semibold" for="contact-town">
              Town
              <select class="field" id="contact-town" name="town" required>
                {towns.map((town) => <option value={town}>{town}</option>)}
              </select>
            </label>
            <label class="grid gap-1 text-sm font-semibold" for="contact-message">
              What happened
              <textarea class="field min-h-32" id="contact-message" name="message" required></textarea>
            </label>
            <button class="btn btn-deep w-full" type="submit">Send</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-request-form]');
  if (form && !form.getAttribute('action')) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const mail = form.dataset.mail || '';
      const body = ['name', 'phone', 'town', 'message']
        .map((key) => `${key}: ${String(data.get(key) || '')}`)
        .join('\n');
      window.location.href = `mailto:${mail}?subject=${encodeURIComponent('Service request')}&body=${encodeURIComponent(body)}`;
    });
  }
</script>
