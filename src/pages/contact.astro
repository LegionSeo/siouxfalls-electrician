---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import LeadHoneypot from '../components/LeadHoneypot.astro';
import PageHero from '../components/PageHero.astro';
import SmsConsent from '../components/SmsConsent.astro';
import { joinNames, services, townPages } from '../config/catalog';
import type { FaqItem } from '../content/home';
import { OPERATOR_EMAIL, SITE, formatAddress, leadAjaxEndpoint } from '../config/site';
import { staticPagePath } from '../lib/lead-form';
import { pagePhoto } from '../lib/photos';
import { breadcrumb } from '../lib/page-schema';
import { faqNode } from '../lib/schema';

const hero = pagePhoto('hero-contact', 'Shop counter with a desk phone and a blank notepad');
const pagePath = staticPagePath(Astro.url.pathname);
const place = `${SITE.address.city}, ${SITE.address.region}`;
const towns = [...SITE.serviceTowns, ...SITE.listOnlyTowns];
const linkedTowns = townPages.filter((town) => town.live);

function serviceByHref(href: string) {
  const service = services.find((item) => item.href === href && item.live);
  if (!service) throw new Error(`Missing live service ${href}`);
  return service;
}

const residential = [
  '/services/electrical-repair',
  '/services/panel-upgrades',
  '/services/wiring-rewiring',
  '/services/lighting-installation',
  '/services/ev-charger-installation',
  '/services/generator-installation',
].map(serviceByHref);

const commercial = [
  '/services/commercial-electrician',
  '/services/lighting-installation',
  '/services/panel-upgrades',
  '/services/electrical-repair',
].map(serviceByHref);

const ready = [
  'Your name and a phone number we can reach.',
  'The town and the street.',
  'Whether it is a house or a business.',
  'What quit, or what you want added.',
  'For a business, the hours a circuit can be off.',
];

const faqs: FaqItem[] = [
  {
    question: 'Do you help with houses and businesses?',
    paragraphs: [
      `${SITE.name} connects you with a local licensed electrician for a commercial or residential project. Call ${SITE.phoneDisplay} and say which one it is. You can also send the note on this page and mark house or business there.`,
    ],
  },
  {
    question: 'What happens after I reach out?',
    paragraphs: [
      `We answer the phone 24 hours a day, 7 days a week. A note from this page gets a reply from Midwest Leads LLC, which connects you with a local licensed electrician. There is no promised time for that reply. If the problem cannot wait, call ${SITE.phoneDisplay}.`,
    ],
  },
  {
    question: 'Which towns do you cover?',
    paragraphs: [
      `We connect you with a local licensed electrician in ${joinNames(SITE.serviceTowns)}. We also take requests from ${joinNames(SITE.listOnlyTowns)}. The town names on this page link to their pages, and the service area page lists them too.`,
    ],
  },
  {
    question: 'What if I see sparks or smell burning?',
    paragraphs: [
      `Keep people away from that outlet, switch, or panel. If you see smoke or fire, get out and call 911. When everyone is safe, call ${SITE.phoneDisplay} and tell us what you saw.`,
    ],
  },
];

const graph = [
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact' },
  ]),
  faqNode(faqs),
];

const successMessage = `Thanks. We got your note. Midwest Leads LLC will reply and connect you with a local licensed electrician. You can also call ${SITE.phoneDisplay}.`;
---

<Layout
  title={`Contact ${SITE.name} | Electrician Referrals in ${place}`}
  schemaName={`Contact ${SITE.name}`}
  description={`Call ${SITE.phoneDisplay}. ${SITE.name} connects you with a local licensed electrician for a house or business in ${place}.`}
  fullTitle
  extraGraph={graph}
  overlay
>
  <PageHero
    photo={hero}
    eyebrow="Contact"
    title={`Contact ${SITE.name}`}
    sub="Tell us about the house or the business. We connect you with a local licensed electrician."
    actions="reach"
  />

  <section class="bg-paper">
    <div class="wrap section">
      <div class="block-head">
        <h2>Glad you are here</h2>
        <p class="lede">{SITE.name} connects you with a local licensed electrician for a commercial or residential project.</p>
      </div>
      <p class="measure">
        Call {SITE.phoneDisplay}. We answer 24 hours a day, 7 days a week. If you send the note, Midwest Leads LLC
        replies and connects you with a local licensed electrician. There is no promised time for that reply.
      </p>

      <div class="contact-layout">
        <div class="contact-panel contact-panel-dark">
          <h2>We answer the phone</h2>
          <p class="measure mt-4 on-dark-soft">
            Use the phone for a house or a business. Tell us the town and what is going on, and we will connect you with a local licensed electrician.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:max-w-sm">
            <a class="btn btn-gold" href={SITE.phoneHref} data-track="call-contact" data-contact-channel="tel">
              <Icon name="phone" class="h-5 w-5" />
              <span>Call {SITE.phoneDisplay}</span>
            </a>
            {
              SITE.smsEnabled && (
                <a class="btn btn-line" href={SITE.smsHref} data-track="sms-contact" data-contact-channel="sms">
                  <Icon name="chat" class="h-5 w-5" />
                  <span>Text {SITE.phoneDisplay}</span>
                </a>
              )
            }
          </div>
          <p class="mt-6 text-sm on-dark-soft">
            Email <a class="text-link-on-dark" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
          <p class="mt-2 text-sm on-dark-soft">
            Email <a class="text-link-on-dark" href={`mailto:${OPERATOR_EMAIL}`}>{OPERATOR_EMAIL}</a>
          </p>
          <address class="mt-4 text-sm not-italic on-dark-soft">{formatAddress()}</address>
        </div>

        <div class="contact-panel contact-panel-form">
          <h2 id="request-form">Tell us about the job</h2>
          <p class="mt-4 text-muted">
            Share your name, a phone number, and what is going on.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Your request goes to Midwest Leads LLC. See our <a class="text-link" href="/privacy-policy">Privacy Policy</a>.
          </p>
          <form
            class="relative mt-6 grid gap-4"
            method="post"
            accept-charset="UTF-8"
            action={SITE.formEndpoint ?? undefined}
            data-request-form
            data-endpoint={leadAjaxEndpoint()}
            data-phone-display={SITE.phoneDisplay}
            data-phone-href={SITE.phoneHref}
            data-success-message={successMessage}
          >
            <LeadHoneypot idPrefix="contact" />
            <input type="hidden" name="_subject" value="New lead: General request - website visitor" />
            <input type="hidden" name="_template" value="basic" />
            <input type="hidden" name="Page" value={pagePath} />
            <label class="grid gap-1 text-sm font-semibold" for="contact-name">
              Name
              <input class="field" id="contact-name" name="name" type="text" required autocomplete="name" />
            </label>
            <label class="grid gap-1 text-sm font-semibold" for="contact-phone">
              Phone
              <input class="field" id="contact-phone" name="phone" type="tel" inputmode="tel" required autocomplete="tel" />
            </label>
            <label class="grid gap-1 text-sm font-semibold" for="contact-email">
              Email <span class="font-semibold text-muted">(optional)</span>
              <input class="field" id="contact-email" name="email" type="email" autocomplete="email" />
            </label>
            <label class="grid gap-1 text-sm font-semibold" for="contact-town">
              Town
              <select class="field" id="contact-town" name="town" required>
                <option value="">Select your town</option>
                {towns.map((town) => <option value={town}>{town}</option>)}
              </select>
            </label>
            <fieldset class="choice-set">
              <legend>House or business</legend>
              <div class="choice-options">
                <label>
                  <input type="radio" name="project" value="Residential" required />
                  Residential
                </label>
                <label>
                  <input type="radio" name="project" value="Commercial" />
                  Commercial
                </label>
              </div>
            </fieldset>
            <fieldset class="choice-set">
              <legend>How urgent</legend>
              <div class="choice-options">
                <label>
                  <input type="radio" name="urgency" value="Emergency now" required />
                  Emergency now
                </label>
                <label>
                  <input type="radio" name="urgency" value="Soon" />
                  Soon
                </label>
                <label>
                  <input type="radio" name="urgency" value="Planning ahead" />
                  Planning ahead
                </label>
              </div>
            </fieldset>
            <label class="grid gap-1 text-sm font-semibold" for="contact-message">
              What is going on
              <textarea class="field min-h-32" id="contact-message" name="message" required></textarea>
            </label>
            <SmsConsent id="contact-sms-consent" />
            <button class="btn btn-gold w-full" type="submit">Send</button>
            <p class="form-status" data-form-status tabindex="-1" role="status" aria-live="polite" aria-atomic="true" hidden></p>
            <p class="text-sm text-muted">
              If the note does not send, call
              <a class="font-bold text-link" href={SITE.phoneHref} data-track="call-contact-form" data-contact-channel="tel">
                {SITE.phoneDisplay}
              </a>.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white" aria-labelledby="work-heading">
    <div class="wrap section">
      <div class="block-head">
        <h2 id="work-heading">Work we can connect you with</h2>
        <p class="lede">Pick the job that sounds like yours. Each link opens the page for that work.</p>
      </div>
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <h3>Residential</h3>
          <ul class="card-grid mt-4">
            {
              residential.map((service) => (
                <li>
                  <a class="text-card" href={service.href}>
                    {service.name}
                    <span class="mt-2 block text-sm font-normal text-muted">{service.summary}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3>Commercial</h3>
          <ul class="card-grid mt-4">
            {
              commercial.map((service) => (
                <li>
                  <a class="text-card" href={service.href}>
                    {service.name}
                    <span class="mt-2 block text-sm font-normal text-muted">{service.summary}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper" aria-labelledby="towns-heading">
    <div class="wrap section">
      <div class="block-head">
        <h2 id="towns-heading">Towns we cover</h2>
        <p class="lede">
          Sioux Falls is home. The other towns below have their own pages.
          We also take requests from {joinNames(SITE.listOnlyTowns)}.
        </p>
      </div>
      <div class="town-chip-row">
        {
          linkedTowns.map((town) => (
            <a class="town-chip" href={town.href}>{town.name}</a>
          ))
        }
      </div>
      <p class="mt-6">
        <a class="text-link" href="/service-area">See the service area page</a>
      </p>
    </div>
  </section>

  <section class="bg-white" aria-labelledby="ready-heading">
    <div class="wrap section">
      <div class="block-head">
        <h2 id="ready-heading">What to have ready when you call</h2>
        <p class="lede">A few plain details help us match you with a local licensed electrician.</p>
      </div>
      <ol class="card-grid">
        {
          ready.map((item, index) => (
            <li class="num-card">
              <span class="num">{index + 1}</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-paper" aria-labelledby="faq-heading">
    <div class="wrap section">
      <div class="block-head">
        <h2 id="faq-heading">Questions before you call</h2>
      </div>
      <div class="town-faq">
        {
          faqs.map((item) => (
            <article>
              <h3>{item.question}</h3>
              {item.paragraphs.map((paragraph) => <p class="measure">{paragraph}</p>)}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand photo={hero} heading="Call and tell us what happened" />
</Layout>
