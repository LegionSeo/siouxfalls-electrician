---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import SideRail from '../../components/SideRail.astro';
import TownElectrical from '../../components/TownElectrical.astro';
import { townPageBySlug, townPagesContent } from '../../content/town-pages';
import { townPlaceBySlug } from '../../content/town-places';
import { faqItemsFor, townBlockBySlug } from '../../content/town-electrical';
import { breadcrumb, serviceNode } from '../../lib/page-schema';
import { faqNode } from '../../lib/schema';
import { SITE } from '../../config/site';

export function getStaticPaths() {
  return townPagesContent.map((page) => ({ params: { town: page.slug } }));
}

const { town } = Astro.params;
const page = townPageBySlug(town);
if (!page) throw new Error(`Missing town page ${town}`);
const place = townPlaceBySlug(page.slug);
if (!place) throw new Error(`Missing town place story ${town}`);

const path = `/locations/${page.slug}`;
const block = townBlockBySlug(page.slug);
if (!block) throw new Error(`Missing town electrical block ${town}`);
const graph = [
  serviceNode(`Electrician referral in ${page.name}, SD`, 'Referral to a licensed electrician', path, [page.name]),
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Service area', path: '/service-area' },
    { name: page.name, path },
  ]),
  faqNode(faqItemsFor(block, SITE.phoneDisplay, SITE.name)),
];
---

<Layout
  title={page.documentTitle}
  schemaName={`Electrician referrals in ${page.name}, SD | ${SITE.name}`}
  description={page.description}
  fullTitle
  extraGraph={graph}
  overlay
>
  <PageHero
    photo={page.photo}
    eyebrow={`${page.name}, South Dakota`}
    title="Electrician referrals in"
    titleAfter={`${page.name}, SD`}
    sub={page.sub}
    town
  />

  <div class="page-split">
    <div class="page-main">
      <TownElectrical
        phone={SITE.phoneDisplay}
        name={SITE.name}
        place={place}
        mapQuery={page.mapQuery}
        preview={page.preview}
        block={block}
      />
    </div>
    <SideRail />
  </div>

  <CtaBand photo={page.photo} heading={`Need an electrician in ${page.name}?`} />
</Layout>
