---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import SideRail from '../../components/SideRail.astro';
import { services } from '../../config/catalog';
import { townPageBySlug, townPagesContent } from '../../content/town-pages';
import { UPDATED_ISO, UPDATED_LABEL } from '../../content/updated';
import { breadcrumb, serviceNode } from '../../lib/page-schema';
import { SITE } from '../../config/site';

export function getStaticPaths() {
  return townPagesContent.map((page) => ({ params: { town: page.slug } }));
}

const { town } = Astro.params;
const page = townPageBySlug(town);
if (!page) throw new Error(`Missing town page ${town}`);

const path = `/locations/${page.slug}`;
const answer = page.answer.replaceAll('{phone}', SITE.phoneDisplay);
const linked = page.services
  .map((href) => services.find((service) => service.href === href))
  .filter((service) => service?.live);
const graph = [
  serviceNode(`Electrician in ${page.name}, SD`, 'Electrician', path, [page.name]),
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Service area', path: '/service-area' },
    { name: page.name, path },
  ]),
];
---

<Layout title={page.documentTitle} description={page.description} fullTitle extraGraph={graph} overlay>
  <PageHero photo={page.photo} eyebrow={`${page.name}, South Dakota`} title={`Electrician in ${page.name}, SD`} sub={page.sub} />

  <div class="page-split">
    <div class="page-main">
      <section class="bg-paper">
        <div class="section">
          <p class="measure text-lg">{answer}</p>
          <p class="mt-6 text-sm text-muted">Updated <time datetime={UPDATED_ISO}>{UPDATED_LABEL}</time></p>
        </div>
      </section>

      <section class="bg-white" aria-labelledby="facts-heading">
        <div class="section">
          <div class="block-head">
            <h2 id="facts-heading">Local facts</h2>
            <p class="lede">
              These numbers are about {page.name}. When you call, tell us the room, the panel, or the circuit.
            </p>
          </div>
          <dl class="stat-grid">
            {
              page.stats.map((stat) => (
                <div class="stat-card">
                  <strong>{stat.value}</strong>
                  <span>{stat.label}</span>
                </div>
              ))
            }
          </dl>
          <p class="measure mt-8 text-muted">{page.detail}</p>
          <div class="block-head mt-12">
            <h2 id="about-heading">About {page.name}</h2>
          </div>
          <p class="measure text-muted">{page.about}</p>
          <div class="block-head mt-12">
            <h2 id="permit-heading">Permits and inspections</h2>
          </div>
          <p class="measure text-muted">{page.permits}</p>
        </div>
      </section>

      <section class="bg-paper" aria-labelledby="work-heading">
        <div class="section">
          <div class="town-work">
            <div>
              <div class="block-head">
                <h2 id="map-heading">Map of {page.name}</h2>
                <p class="lede">This pin marks the town, not your house. When you call, give us the address where you need us.</p>
              </div>
              <MapEmbed
                src={`https://www.google.com/maps?q=${encodeURIComponent(page.mapQuery)}&z=12&output=embed`}
                title={`Map of ${page.name}, South Dakota`}
                label={page.mapQuery}
                preview={page.preview}
              />
            </div>
            <div>
              <div class="block-head">
                <h2 id="work-heading">Electrical work in {page.name}</h2>
                <p class="lede">These are the services most people in {page.name} ask about first. The full list is on the homepage.</p>
              </div>
              <ServiceCards services={linked} />
              <p class="mt-6">
                <a class="text-link" href="/service-area">Back to the service area</a>
              </p>
            </div>
          </div>
        </div>
      </section>

      <FaqAccordion items={page.faqs} heading={`${page.name} questions`} />
    </div>
    <SideRail />
  </div>

  <CtaBand photo={page.photo} heading={`Need an electrician in ${page.name}?`} />
</Layout>
