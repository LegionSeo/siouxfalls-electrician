---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import IconSprite from '../components/IconSprite.astro';
import SEO from '../components/SEO.astro';
import StickyCallBar from '../components/StickyCallBar.astro';
import { SITE, canonicalUrl } from '../config/site';
import { jsonLdScript, siteGraph } from '../lib/schema';

interface Props {
  title: string;
  description?: string;
  /** Ignored. Canonicals always use SITE.origin plus the path, with no trailing slash. */
  canonical?: string;
  fullTitle?: boolean;
  extraGraph?: Record<string, unknown>[];
}

const { title, description, fullTitle, extraGraph = [] } = Astro.props;
const pageTitle = fullTitle ? title : `${title} | ${SITE.name}`;
const pageDescription =
  description ??
  `${SITE.name} serves homes and businesses in Sioux Falls, SD and nearby towns. Call ${SITE.phoneDisplay}.`;
const pageCanonical = canonicalUrl(Astro.url.pathname);
const jsonLd = jsonLdScript(siteGraph(extraGraph));
---

<!doctype html>
<html lang="en" data-theme={SITE.theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={pageTitle} description={pageDescription} canonical={pageCanonical} />
    <slot name="head" />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class="min-h-screen bg-paper font-sans text-text antialiased">
    <a class="skip-link" href="#content">Skip to content</a>
    <IconSprite />
    <Header />
    <main id="content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <StickyCallBar />
    <script is:inline>
      (function () {
        document.addEventListener('click', function (event) {
          var node = event.target;
          var link = node && node.closest ? node.closest('a[href^="tel:"], a[href^="sms:"]') : null;
          if (!link) return;
          var href = link.getAttribute('href') || '';
          var channel = href.indexOf('sms:') === 0 ? 'sms' : 'call';
          var label = link.getAttribute('data-track') || channel;
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: channel === 'sms' ? 'sms_click' : 'call_click',
            contact_channel: channel,
            contact_location: label,
            link_url: href
          });
          if (typeof window.gtag === 'function') {
            window.gtag('event', channel === 'sms' ? 'sms_click' : 'call_click', {
              event_category: 'contact',
              event_label: label,
              link_url: href
            });
          }
        });

        var header = document.querySelector('[data-site-header]');
        if (header) {
          var desktop = window.matchMedia('(min-width: 1024px)');
          var onScroll = function () {
            if (!desktop.matches || window.scrollY <= 8) header.removeAttribute('data-compact');
            else header.setAttribute('data-compact', '');
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }

        var bar = document.querySelector('[data-sticky-bar]');
        var form = document.querySelector('[data-request-form]');
        if (bar && form && window.location.pathname.indexOf('/contact') === 0 && 'IntersectionObserver' in window) {
          var observer = new IntersectionObserver(function (entries) {
            var hide = entries[0].isIntersecting;
            bar.hidden = hide;
            document.body.classList.toggle('bar-hidden', hide);
          });
          observer.observe(form);
        }
      })();
    </script>
  </body>
</html>
